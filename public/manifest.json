{
  "manifest_version": 3,
  "name": "FocusFox",
  "version": "1.0.1",
  "description": "A focused browser homepage with search engines and customizable shortcuts.",

  "browser_specific_settings": {
    "gecko": {
      "id": "focusfox@example.com"
    }
  },

  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  
  "permissions": [
    "storage"
  ]
}